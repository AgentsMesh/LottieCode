// 旋转 loader —— 演示完整旋转动画 + 命名 easing

composition "loader" {
    width    = 100
    height   = 100
    fps      = 30
    duration = 1.5s

    shape ring {
        ellipse  { size = [60, 60] }
        stroke   = { color = #6366F1, width = 4, cap = round, join = round }
        position = [50, 50]

        animate trim-end {
            0s:    0
            0.6s:  100  ease = ease-in-out
            1.5s:  100
        }
        animate rotation {
            0s:    0
            1.5s:  360  ease = ease-in-out
        }
    }
}
