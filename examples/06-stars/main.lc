// 五颗星 stagger 入场 —— 拆掉 Repeater 改用 5 个独立 shape，依次出现再退出
// 这才是 motion design 中真正的 stagger pattern。

composition "stars" {
    width    = 400
    height   = 200
    fps      = 30
    duration = 2s

    shape star1 {
        polystar { points = 5, outer-radius = 24, inner-radius = 10, type = star }
        fill = #FFD700
        position = [60, 100]
        animate scale {
            0s:    [0, 0, 100]
            0.3s:  [120, 120, 100]  ease = ease-out-back
            0.5s:  [100, 100, 100]
            1.2s:  [100, 100, 100]  hold
            1.5s:  [0, 0, 100]      ease = ease-in
            2s:    [0, 0, 100]
        }
    }
    shape star2 {
        polystar { points = 5, outer-radius = 24, inner-radius = 10, type = star }
        fill = #FFD700
        position = [130, 100]
        animate scale {
            0s:    [0, 0, 100]
            0.1s:  [0, 0, 100]      hold
            0.4s:  [120, 120, 100]  ease = ease-out-back
            0.6s:  [100, 100, 100]
            1.3s:  [100, 100, 100]  hold
            1.6s:  [0, 0, 100]      ease = ease-in
            2s:    [0, 0, 100]
        }
    }
    shape star3 {
        polystar { points = 5, outer-radius = 24, inner-radius = 10, type = star }
        fill = #FFD700
        position = [200, 100]
        animate scale {
            0s:    [0, 0, 100]
            0.2s:  [0, 0, 100]      hold
            0.5s:  [120, 120, 100]  ease = ease-out-back
            0.7s:  [100, 100, 100]
            1.4s:  [100, 100, 100]  hold
            1.7s:  [0, 0, 100]      ease = ease-in
            2s:    [0, 0, 100]
        }
    }
    shape star4 {
        polystar { points = 5, outer-radius = 24, inner-radius = 10, type = star }
        fill = #FFD700
        position = [270, 100]
        animate scale {
            0s:    [0, 0, 100]
            0.3s:  [0, 0, 100]      hold
            0.6s:  [120, 120, 100]  ease = ease-out-back
            0.8s:  [100, 100, 100]
            1.5s:  [100, 100, 100]  hold
            1.8s:  [0, 0, 100]      ease = ease-in
            2s:    [0, 0, 100]
        }
    }
    shape star5 {
        polystar { points = 5, outer-radius = 24, inner-radius = 10, type = star }
        fill = #FFD700
        position = [340, 100]
        animate scale {
            0s:    [0, 0, 100]
            0.4s:  [0, 0, 100]      hold
            0.7s:  [120, 120, 100]  ease = ease-out-back
            0.9s:  [100, 100, 100]
            1.6s:  [100, 100, 100]  hold
            1.9s:  [0, 0, 100]      ease = ease-in
            2s:    [0, 0, 100]
        }
    }
}
