// Precomp 嵌套合成 —— 4 张卡片依次缩放弹入

precomp card {
    width    = 200
    height   = 100
    fps      = 30
    duration = 2s

    shape bg {
        rect { size = [200, 100], radius = 12 }
        fill = #6366F1
        position = [100, 50]
    }

    shape badge {
        ellipse { size = [24, 24] }
        fill = #FFD700
        position = [180, 20]

        animate scale {
            0s:    [0, 0, 100]
            0.5s:  [120, 120, 100]  ease = ease-out-back
            0.7s:  [100, 100, 100]
        }
    }
}

composition "card-grid" {
    width    = 600
    height   = 300
    fps      = 30
    duration = 2s

    precomp card-1 {
        asset = card
        position = [110, 60]
        animate opacity {
            0s:    0
            0.3s:  0
            0.6s:  100  ease = ease-out
        }
        animate scale {
            0s:    [50, 50, 100]
            0.6s:  [110, 110, 100]  ease = ease-out-back
            0.9s:  [100, 100, 100]
        }
    }
    precomp card-2 {
        asset = card
        position = [320, 60]
        animate opacity {
            0s:    0
            0.5s:  0
            0.8s:  100  ease = ease-out
        }
        animate scale {
            0s:    [50, 50, 100]
            0.8s:  [110, 110, 100]  ease = ease-out-back
            1.1s:  [100, 100, 100]
        }
    }
    precomp card-3 {
        asset = card
        position = [110, 200]
        animate opacity {
            0s:    0
            0.7s:  0
            1s:    100  ease = ease-out
        }
        animate scale {
            0s:    [50, 50, 100]
            1s:    [110, 110, 100]  ease = ease-out-back
            1.3s:  [100, 100, 100]
        }
    }
    precomp card-4 {
        asset = card
        position = [320, 200]
        animate opacity {
            0s:    0
            0.9s:  0
            1.2s:  100  ease = ease-out
        }
        animate scale {
            0s:    [50, 50, 100]
            1.2s:  [110, 110, 100]  ease = ease-out-back
            1.5s:  [100, 100, 100]
        }
    }
}
