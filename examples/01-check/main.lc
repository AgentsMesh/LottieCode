// 勾选成功动画 —— LottieCode Phase 1 端到端 demo。
// 等价于 research/samples/sample-success.json：环先画完，勾再画出。

token color {
    success = #1EBF75
}

composition "check" {
    width    = 64
    height   = 64
    fps      = 60
    duration = 1.5s

    shape ring {
        ellipse  { size = [159, 159] }
        stroke   = { color = color.success, width = 3, cap = round, join = round }
        position = [32, 32]
        scale    = 33.333

        animate trim {
            0s:    { start = 0, end = 0,   offset = -360 }
            1.283s:{ start = 0, end = 100, offset = 0 } ease = cubic(0.66, 0, 0.34, 1)
        }
    }

    shape check {
        path     = "M27.75 -18 L-8.25 18 L-27.75 -1.5"
        stroke   = { color = color.success, width = 3, cap = round, join = round }
        position = [32, 32]
        scale    = 33.333

        animate trim-end {
            0.733s: 0
            1.5s:   100  ease = cubic(0.461, 0, 0.466, 1)
        }
    }
}
