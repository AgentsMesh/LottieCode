// 三个加载点 —— stagger 接力跳动（设计师常用的 loading dots pattern）
// 演示：3 个独立 shape + 错位时间序列；动画循环可见。

composition "loading-dots" {
    width    = 200
    height   = 60
    fps      = 30
    duration = 1.2s

    shape dot1 {
        ellipse { size = [20, 20] }
        fill = #6366F1
        position = [60, 30]

        animate scale {
            0s:    [60, 60, 100]
            0.2s:  [120, 120, 100]  ease = ease-out
            0.4s:  [60, 60, 100]    ease = ease-in
            1.2s:  [60, 60, 100]
        }
    }
    shape dot2 {
        ellipse { size = [20, 20] }
        fill = #6366F1
        position = [100, 30]

        animate scale {
            0s:    [60, 60, 100]
            0.2s:  [60, 60, 100]    hold
            0.4s:  [120, 120, 100]  ease = ease-out
            0.6s:  [60, 60, 100]    ease = ease-in
            1.2s:  [60, 60, 100]
        }
    }
    shape dot3 {
        ellipse { size = [20, 20] }
        fill = #6366F1
        position = [140, 30]

        animate scale {
            0s:    [60, 60, 100]
            0.4s:  [60, 60, 100]    hold
            0.6s:  [120, 120, 100]  ease = ease-out
            0.8s:  [60, 60, 100]    ease = ease-in
            1.2s:  [60, 60, 100]
        }
    }
}
